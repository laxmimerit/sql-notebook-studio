 "sql": {
  "demo": "SELECT c.name, count(*) AS orders\nFROM customers c\nJOIN orders o ON o.customer_id = c.id\nWHERE o.created_at > '2025-12-01'\nGROUP BY c.name\nORDER BY orders DESC\nLIMIT 10",
  "filter": "SELECT name, city\nFROM customers\nWHERE city = 'Pune'\nORDER BY name",
  "count": "SELECT count(*)\nFROM orders\nWHERE amount > 5",
  "cte": "WITH big AS (\n  SELECT customer_id, sum(amount) AS total\n  FROM orders\n  GROUP BY customer_id\n)\nSELECT c.name, b.total\nFROM big b\nJOIN customers c ON c.id = b.customer_id\nWHERE b.total > 100\nORDER BY b.total DESC",
  "union": "SELECT id, name FROM customers\nWHERE id IN (SELECT customer_id FROM orders WHERE amount > 5)\nUNION ALL\nSELECT id, name FROM customers\nWHERE city = 'Pune'",
  "del": "DELETE FROM orders\nWHERE created_at < '2024-02-01'"
 }
